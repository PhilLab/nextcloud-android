<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        FairScan's own scanning UI, compiled into this app rather than launched as a separate
        installed app - see :fairscan/build.gradle.kts. MainActivity is launched explicitly with
        the org.fairscan.app.action.SCAN_TO_PDF action FairScan's own MainActivity.resolveLaunchMode()
        already switches on, so it isn't exported for cross-app resolution the way FairScan's own
        manifest declares it.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- WRITE_EXTERNAL_STORAGE and INTERNET are already declared, more broadly, by :app itself. -->

    <application>
        <activity
            android:name="org.fairscan.app.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.FairScan" />

        <!--
            Fixed authority, matching the override at
            src/main/java-overrides/org/fairscan/app/ui/FileUris.kt - see that file's own header
            for why it isn't "${applicationId}.fileprovider" (what FairScan's own uriForFile()
            would otherwise compute), and FairScanFileProvider's own header for why this isn't
            just androidx.core.content.FileProvider like FairScan's own manifest declares.
        -->
        <provider
            android:name="org.fairscan.app.FairScanFileProvider"
            android:authorities="org.fairscan.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
